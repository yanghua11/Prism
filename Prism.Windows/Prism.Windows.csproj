<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 强制只使用本地 NuGet 包缓存 -->
    <NuGetPackageFolders>C:\Users\Administrator\.nuget\packages\</NuGetPackageFolders>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 使用桌面 RID 格式（兼容 .NET 9 SDK） -->
    <UseDesktopRIDFormat>true</UseDesktopRIDFormat>
    <!-- 显式定义 RID 别名映射 -->
    <RuntimeIdentifierAliases>win10-x64;win-x64;win10-x86;win-x86;win10-arm;win-arm;win10-arm64-aot;win-arm64</RuntimeIdentifierAliases>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>Prism.Windows</RootNamespace>
    <AssemblyName>Prism.Windows</AssemblyName>
    <ApplicationIcon />
    <StartupObject />

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- WinUI 3 桌面应用（非 MSIX 包） -->
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <GenerateLibraryLayout>false</GenerateLibraryLayout>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>

    <!-- CI 优化：禁用 MSIX 打包，避免需要证书 -->
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <EnablePreviewMsixTooling>false</EnablePreviewMsixTooling>

    <!-- 发布属性：用于 single-file &amp; self-contained 发布 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PakTool.Core\PakTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.WindowsAPICodePack-Shell" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\third_party\lib\win-x64\*.dll" Link="third_party\lib\win-x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\third_party\lib\win-x64\')" />
  </ItemGroup>

</Project>
