<Window x:Class="Prism.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Prism.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Prism - Unreal Pak Browser"
    Width="1200" Height="800"
    MinWidth="800" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource LightBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- 顶部: 状态/进度栏 -->
        <Border Grid.Row="0" Background="{StaticResource LightSurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Select a .pak file to begin."
                           VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                <ProgressBar x:Name="ProgressBar" Grid.Column="1" Width="200" IsIndeterminate="False"
                             Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- 中部: 路径选择行 -->
        <Border Grid.Row="1" Background="{StaticResource LightSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pak 文件选择 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pak File:" VerticalAlignment="Center" Margin="0,0,8,8"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBox x:Name="PakPathTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,8"
                         PlaceholderText="No file selected" />
                <Button x:Name="SelectPakButton" Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="0,0,0,8" />

                <!-- Usmap 文件选择 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Usmap:" VerticalAlignment="Center" Margin="0,0,8,8"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBox x:Name="UsmapPathTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,8"
                         PlaceholderText="Optional mapping file" />
                <Button x:Name="SelectUsmapButton" Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="0,0,0,8" />

                <!-- AES 密钥与打开按钮 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="AES Key:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBox x:Name="AesKeyTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"
                         PlaceholderText="Optional hex key (e.g., 0x...)" />
                <Button x:Name="OpenPakButton" Grid.Row="2" Grid.Column="2" Content="Open Pak"
                        IsEnabled="False" />
            </Grid>
        </Border>

        <!-- 文件浏览区 -->
        <Border Grid.Row="2" Background="{StaticResource LightSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 面包屑路径与向上按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GoUpButton" Grid.Column="0" Content="⬆ Up" Margin="0,0,8,0" IsEnabled="False" />
                    <TextBlock x:Name="PathBreadcrumb" Grid.Column="1" Text="/" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" />
                </Grid>

                <!-- 搜索框 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox" Grid.Column="0" PlaceholderText="Search files..."
                             Margin="0,0,8,0" />
                    <Button x:Name="SearchButton" Grid.Column="1" Content="Search" />
                </Grid>

                <!-- 条目列表 -->
                <ListView x:Name="FileListView" Grid.Row="2" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:EntryViewModel">
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 分隔线 -->
                <Border Grid.Row="3" Height="1" Background="#E0E0E0" Margin="0,8" />

                <!-- 选中/预览区 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 预览区 -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SelectedItemSummary" Grid.Row="0" Text="No item selected"
                                   Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Image x:Name="TexturePreviewImage" Grid.Row="1" Stretch="Uniform" />
                    </Grid>

                    <!-- 导出按钮 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="120">
                        <Button x:Name="ExportRawButton" Content="Export Raw" IsEnabled="False" Margin="0,0,0,8" />
                        <Button x:Name="ExportPngButton" Content="Export PNG" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Oodle 状态 -->
        <Border Grid.Row="3" Background="{StaticResource LightSurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="OodleStatusText" Text="Oodle native not checked."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
        </Border>

        <!-- 底部: 诊断日志 -->
        <Border Grid.Row="4" Background="{StaticResource LightSurfaceBrush}" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Diagnostics" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock x:Name="DiagnosticsLog" Text="" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
